# DMI College Hostel Management PWA — Environment Variables Template
# Copy this file to .env.local for local development.

# Application Environment
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Backend API Configuration
# In frontend-only mock mode, leave these empty. The service layer falls back to client mock stores.
NEXT_PUBLIC_API_BASE_URL=

# Supabase Integration (Phase 7+ Backend Handoff)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Cryptographic Gate QR Poster Signer Key (HMAC-SHA256 / Ed25519)
# Used exclusively server-side to sign and rotate daily gate QR codes
GATE_QR_SECRET_KEY=dmi_gate_secret_production_key_32bytes_minimum

# Cloud Storage Buckets (Photos & Student Letters)
STORAGE_PROVIDER=supabase
STORAGE_BUCKET_PHOTOS=student-photos
STORAGE_BUCKET_LETTERS=student-letters

# Web Push Notifications (Firebase Cloud Messaging / Web Push)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BKagO_xU...
VAPID_PRIVATE_KEY=your_private_vapid_key
VAPID_SUBJECT=mailto:admin@dmice.ac.in

# Error Tracking & Telemetry (Sentry)
NEXT_PUBLIC_SENTRY_DSN=https://your-dsn@sentry.io/123456
SENTRY_AUTH_TOKEN=sntrys_...
